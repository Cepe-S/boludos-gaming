# ==============================================================================
# BOLUDOS GAMING — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` or `.env.local` to configure your environment.
# Note: The frontend is fully operational in standalone/demo mode even without
# configuring any of these variables (using localStorage + BroadcastChannel).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client-Side)
# ------------------------------------------------------------------------------

# Supabase Project URL and Anon Public Key (Supabase Free Tier)
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Discord Webhook URL for Zero-Backend Channel Notifications
# Create one in: Discord Server -> Channel Settings -> Integrations -> Webhooks
# When configured, any session creation, check-in, late ping, or roulette winner
# is dispatched with rich gamer embeds directly to this channel.
VITE_DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"

# Web Push VAPID Public Key for PWA Notifications
# Generate a free VAPID keypair by running: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY="BEl62iUYgUivxIkv69yViEuiBIa-Ib9-SkvMeAtA3LFgDzkrxZJjSgUOnhQE9NdWP0123456789abcdefg"

# ------------------------------------------------------------------------------
# 2. SUPABASE EDGE FUNCTIONS SECRETS (Serverless Discord Bot & Push)
# ------------------------------------------------------------------------------
# Set these secrets in your Supabase project with:
#   supabase secrets set NAME=VALUE
# ------------------------------------------------------------------------------

# Supabase Service Role Key (Admin access for Edge Functions)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Discord Application / Bot Credentials (from Discord Developer Portal)
# Create a free bot at https://discord.com/developers/applications
DISCORD_APPLICATION_ID="123456789012345678"
DISCORD_PUBLIC_KEY="a1b2c3d4e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef0"
DISCORD_BOT_TOKEN="your_discord_bot_token_from_developer_portal"
DISCORD_CHANNEL_ID="123456789012345678"

# Web Push VAPID Private Key & Contact Subject (RFC 8292)
VAPID_PRIVATE_KEY="your-private-vapid-key-generated-by-web-push"
VAPID_SUBJECT="mailto:admin@boludosgaming.app"
